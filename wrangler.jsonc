// Cloudflare Workers deploy: serves the game as static assets and runs the online API
// (worker/index.js) for /api/* routes. Deployed by Cloudflare's Git integration on push to main.
{
  "name": "moba-vs",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "keep_vars": true, // keep variables added in the Cloudflare dashboard (e.g. MOBAVS_ADMIN, VAPID_*) across git deploys
  "preview_urls": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "mobavs", "database_id": "3d5ba5ca-a188-4f3b-9a39-656c2c201d59" }
  ],
  // Free plan cron triggers (worker/index.js scheduled): every 5 minutes drain queued push notifications,
  // and at 03:07 UTC roll up the live-ops stats (DAU / WAU / retention) and prune old rows.
  "triggers": { "crons": ["*/5 * * * *", "7 3 * * *"] },
  // Web Push keys are Worker secrets, not vars, so a deploy never overwrites them:
  // VAPID_PUBLIC, VAPID_PRIVATE, VAPID_SUBJECT (tools/push.mjs --keys makes a pair). Unset = notifications off.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
